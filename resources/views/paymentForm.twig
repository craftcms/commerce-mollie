{% if paymentMethods|length %}
  <div class="mollie-form">
    <select name="paymentMethod">
      {% for method in paymentMethods %}
        <option value="{{ method.id }}"{{ paymentForm.paymentMethod == method.id ? ' selected' }}>{{ method.name }}</option>
      {% endfor %}
    </select>

    {% set methodsWithIssuers = paymentMethods|filter(method => method.issuers|length) %}
    {% if methodsWithIssuers|length %}
      <select name="issuer">
        {% for method in methodsWithIssuers %}
          <optgroup label="{{ method.name }}">
            {% for issuer in method.issuers %}
              <option value="{{ issuer.id }}"{{ paymentForm.issuer == issuer.id ? ' selected' }}>{{ issuer.name }}</option>
            {% endfor %}
          </optgroup>
        {% endfor %}
      </select>
    {% endif %}
  </div>
{% endif %}
